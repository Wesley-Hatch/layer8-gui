# Layer8 GUI - .gitignore

# Secrets / local config
.env
.env.local
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
.Python

# Virtual environments
.venv/
.venv_broken314/
venv/
env/
ENV/

# PyInstaller / build output
build/
dist/
release/
*.spec
*.manifest

# Distributable binaries (published to GitHub Releases, not committed)
*.exe
*.app
*.dmg
*.zip
*.tar.gz

# Runtime state (generated by the app / updater)
version.json
update_config.json
temp_update/
backups/

# Logs
*.log
logs/

# Tool output
captures/
scans/
reports/

# John the Ripper is user-provided, not bundled (see tools/john/README.md)
tools/john/*
!tools/john/README.md

# Old / scratch
_old_desktop_builds/

# IDE / OS
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store
desktop.ini
