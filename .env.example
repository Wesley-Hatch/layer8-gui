# Layer8 GUI - optional configuration
#
# The app needs NO configuration to run. Sign-in is verified against the
# Layer8 web console over the internet. Copy this file to ".env" only if you
# want to enable the optional extras below.

# Optional: enables the AI log-analysis feature.
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Optional (advanced): point the app at a different access-console endpoint,
# e.g. a local dev server. Defaults to the production console.
# L8_ACCESS_API_URL=https://hatchtag.dev/access/api/v1/verify.php

# Optional (advanced): override the version the app reports to the console.
# L8_APP_VERSION=1.4.2
